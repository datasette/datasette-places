{
  "name": "datasette-places-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('../datasette_places/static/gen',{recursive:true,force:true});fs.rmSync('../datasette_places/manifest.json',{force:true})\"",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "@types/leaflet": "^1.9.14"
  }
}
